# Copy to .env.local and fill in the password. .env* is gitignored.
#
# Supabase, shared (transaction) pooler on 6543 — not the direct connection on 5432.
# Vercel functions are serverless: each invocation opens a connection, and a direct
# Postgres connection limit is exhausted quickly. Supavisor exists for exactly this.
#
# If the password contains special characters, percent-encode them.
DATABASE_URL=postgresql://postgres.nvhqbylyctmjdkvnxxjo:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
