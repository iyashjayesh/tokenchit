# Copy to .env.local and fill in the connection string. .env* is gitignored.
#
# Neon is the documented default — see docs/research.md §4, and the Supported by section in
# the README. Any Postgres works: the site reads this one variable and nothing below it knows
# who serves it.
#
# Use the POOLED endpoint, the host with `-pooler` in it. Vercel functions are serverless:
# each invocation opens a connection, and a direct Postgres connection limit is exhausted
# quickly. The pool in lib/db.ts is capped at 5 to match.
#
# If the password contains special characters, percent-encode them.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/tokenchit?sslmode=require

# Other providers work unchanged, with their own pooled endpoint:
#   Supabase — the shared (transaction) pooler on 6543, not the direct connection on 5432
#   Local    — postgres://tokenchit:tokenchit@localhost:5432/tokenchit
