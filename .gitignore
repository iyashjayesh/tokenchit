# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and contributors need it
!.env.example
!apps/site/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workspace build output
packages/*/dist

# scratch space for local verification
.scratch/

# local MCP server config — personal tooling, not project setup
.mcp.json
